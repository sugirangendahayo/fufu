NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://fufu_user:Shushu%402023@localhost:5432/fufu_db"
CORS_ORIGINS=http://localhost:8081
ACCESS_TOKEN_SECRET=replace-with-a-random-32-character-minimum-secret
REFRESH_TOKEN_SECRET=replace-with-a-different-random-32-character-minimum-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
DELIVERY_FEE_RWF=1000
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
# Pindo Verify — get your token at https://app.pindo.io → Settings → API Tokens
PINDO_API_TOKEN=
# Brand name shown in the OTP SMS (max 32 chars). Must match an approved sender ID on your Pindo account.
PINDO_VERIFY_BRAND=Fufu
# Set to true ONLY in development to bypass SMS OTP (e.g. when Pindo wallet has no balance).
# NEVER set to true in production.
SKIP_PHONE_VERIFICATION=false
